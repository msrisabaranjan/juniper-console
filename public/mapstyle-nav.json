{
  "version": 8,
  "name": "juniper-hud-3d",
  "attribution": "© OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors",
  "metadata": {
    "juniper-console:comment": "Wireframe 3D HUD style for the NAVIGATE page (Roadster nav homage): black void, white line-art roads, extruded ghost building blocks. Road colors are re-tinted at runtime from the UI accent via mapView.setAccent(); building lines stay chalk-white in both themes. Same road layer ids as mapstyle.json so one accent pass covers both."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#020203" }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "maxzoom": 16,
      "filter": ["all", ["==", ["geometry-type"], "Polygon"], ["==", ["get", "class"], "residential"]],
      "paint": {
        "fill-color": "#07080a",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 12, 0.8]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#060c07" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#060d13" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 12,
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#101a24", "line-width": 1 }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 8,
      "filter": [">=", ["get", "admin_level"], 3],
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.10)",
        "line-dasharray": [1, 1],
        "line-width": 1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#0a0c0f",
        "fill-outline-color": "#1b1e22"
      }
    },
    {
      "id": "building_3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "rgba(255, 255, 255, 0.055)",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 8],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.72
      }
    },
    {
      "id": "building_outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13.5,
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.5)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13.5, 0.4, 17, 1.1]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["rail", "transit"], true, false]],
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.16)",
        "line-dasharray": [2, 2],
        "line-width": 1.2
      }
    },
    {
      "id": "road_path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "path"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.16)",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.7, 20, 5]
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["minor", "service", "track"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(220, 225, 230, 0.40)",
        "line-width": ["interpolate", ["exponential", 1.55], ["zoom"], 11, 0.7, 14, 1.9, 20, 9]
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(255, 45, 45, 0.95)",
        "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 8, 0.9, 12, 2.4, 20, 16]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "motorway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgb(255, 45, 45)",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 6, 0.9, 12, 3, 20, 20]
      }
    },
    {
      "id": "label_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 13,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": ["interpolate", ["exponential", 1.2], ["zoom"], 4, 11, 12, 16]
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 0.55)",
        "text-halo-color": "rgba(0, 0, 0, 0.9)",
        "text-halo-width": 2
      }
    },
    {
      "id": "label_locality",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "maxzoom": 15,
      "filter": ["match", ["get", "class"], ["town", "village", "suburb", "neighbourhood", "hamlet"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 10, 14, 13]
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 0.4)",
        "text-halo-color": "rgba(0, 0, 0, 0.9)",
        "text-halo-width": 2
      }
    }
  ]
}
