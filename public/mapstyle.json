{
  "version": 8,
  "name": "juniper-hud",
  "attribution": "© OpenFreeMap · © OpenMapTiles · © OpenStreetMap contributors",
  "metadata": {
    "juniper-console:comment": "Dark HUD restyle of OpenFreeMap (OpenMapTiles schema). Road colors are re-tinted at runtime from the UI accent via mapView.setAccent(); the values here are the Crimson default."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#050505" }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "maxzoom": 16,
      "filter": ["all", ["==", ["geometry-type"], "Polygon"], ["==", ["get", "class"], "residential"]],
      "paint": {
        "fill-color": "#0a0b0d",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 12, 0.8]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#0a100b" }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 10,
      "filter": ["all", ["==", ["geometry-type"], "Polygon"], ["==", ["get", "class"], "wood"]],
      "paint": {
        "fill-color": "#0b0f0a",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.3, 13, 0.8]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#0a1219" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 12,
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#16222e", "line-width": 1 }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 8,
      "filter": [">=", ["get", "admin_level"], 3],
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.12)",
        "line-dasharray": [1, 1],
        "line-width": 1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#14161a",
        "fill-outline-color": "#1e2126"
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["rail", "transit"], true, false]],
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.16)",
        "line-dasharray": [2, 2],
        "line-width": 1.2
      }
    },
    {
      "id": "road_path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "path"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(255, 45, 45, 0.25)",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.8, 20, 6]
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["minor", "service", "track"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(255, 45, 45, 0.45)",
        "line-width": ["interpolate", ["exponential", 1.55], ["zoom"], 11, 0.6, 14, 1.6, 20, 8]
      }
    },
    {
      "id": "road_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgba(255, 45, 45, 0.85)",
        "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 8, 0.8, 12, 2, 20, 14]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "motorway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "rgb(255, 45, 45)",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 6, 0.8, 12, 2.5, 20, 18]
      }
    },
    {
      "id": "label_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 13,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": ["interpolate", ["exponential", 1.2], ["zoom"], 4, 11, 12, 16]
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 0.55)",
        "text-halo-color": "rgba(0, 0, 0, 0.9)",
        "text-halo-width": 2
      }
    },
    {
      "id": "label_locality",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "maxzoom": 15,
      "filter": ["match", ["get", "class"], ["town", "village", "suburb", "neighbourhood", "hamlet"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 10, 14, 13]
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 0.4)",
        "text-halo-color": "rgba(0, 0, 0, 0.9)",
        "text-halo-width": 2
      }
    }
  ]
}
